<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Instrumental</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\AmbientTasks.snk</AssemblyOriginatorKeyFile>

    <Version>2.0.0</Version>
    <PackageReleaseNotes>The namespace is changing to the individual author's new personal namespace, Instrumental. This reflects that the individual author is now the copyright holder rather than the company whose namespace was previously used.

(https://github.com/jnm2/AmbientTasks/blob/$(ShortCommitHash)/CHANGELOG.md#unreleased)</PackageReleaseNotes>
    <Authors>Joseph N. Musser II</Authors>
    <Copyright>Copyright © 2019–2026 Joseph N. Musser II</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jnm2/AmbientTasks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jnm2/AmbientTasks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>async task void post background ambient scope wait track handle error</PackageTags>
    <Description>Enables scoped completion tracking and error handling of tasks as an alternative to fire-and-forget and async void. Easy to produce and consume, and test-friendly.</Description>
    <EmbedAllSources>true</EmbedAllSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetAnalyzers.DocumentationAnalyzers" Version="1.0.0-beta.59" PrivateAssets="all" />
    <PackageReference Include="Microsoft.DotNet.Analyzers.Compatibility" Version="0.2.12-alpha" PrivateAssets="all" />
  </ItemGroup>

</Project>
